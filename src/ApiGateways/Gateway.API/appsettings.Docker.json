{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ReverseProxy": {
    "Clusters": {
      "catalog-cluster": {
        "Destinations": {
          "catalog": {
            "Address": "http://catalog.api:8080"
          }
        }
      },
      "basket-cluster": {
        "Destinations": {
          "basket": {
            "Address": "http://basket.api:8080"
          }
        }
      },
      "order-cluster": {
        "Destinations": {
          "order": {
            "Address": "http://order.api:8080"
          }
        }
      }
    }
  }
}
