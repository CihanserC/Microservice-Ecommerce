{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "catalog-route": {
        "ClusterId": "catalog-cluster",
        "Match": {
          "Path": "/catalog/{**remainder}"
        },
        "Transforms": [
          { "PathPattern": "/api/products/{**remainder}" }
        ]
      },
      "catalog-root-route": {
        "ClusterId": "catalog-cluster",
        "Match": {
          "Path": "/catalog"
        },
        "Transforms": [
          { "PathPattern": "/api/products" }
        ]
      },
      "basket-route": {
        "ClusterId": "basket-cluster",
        "Match": {
          "Path": "/basket/{**remainder}"
        },
        "Transforms": [
          { "PathPattern": "/api/basket/{**remainder}" }
        ]
      },
      "basket-root-route": {
        "ClusterId": "basket-cluster",
        "Match": {
          "Path": "/basket"
        },
        "Transforms": [
          { "PathPattern": "/api/basket" }
        ]
      },
      "order-route": {
        "ClusterId": "order-cluster",
        "Match": {
          "Path": "/orders/{**remainder}"
        },
        "Transforms": [
          { "PathPattern": "/api/orders/{**remainder}" }
        ]
      },
      "order-root-route": {
        "ClusterId": "order-cluster",
        "Match": {
          "Path": "/orders"
        },
        "Transforms": [
          { "PathPattern": "/api/orders" }
        ]
      }
    },
    "Clusters": {
      "catalog-cluster": {
        "Destinations": {
          "catalog": {
            "Address": "http://localhost:5001"
          }
        }
      },
      "basket-cluster": {
        "Destinations": {
          "basket": {
            "Address": "http://localhost:5002"
          }
        }
      },
      "order-cluster": {
        "Destinations": {
          "order": {
            "Address": "http://localhost:5003"
          }
        }
      }
    }
  }
}
